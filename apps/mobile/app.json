{
  "expo": {
    "name": "댕댕케어",
    "slug": "daengdaeng-care",
    "scheme": "daengdaeng",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "care.daengdaeng.app"
    },
    "android": {
      "package": "care.daengdaeng.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFDF9"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "반려견 프로필 사진을 고르기 위해 사진 보관함에 접근해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "근처 동물병원을 거리순으로 보여주기 위해 현재 위치를 사용해요.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8147dac2-63d4-48ef-bea9-74e86ee679a1"
      }
    }
  }
}
