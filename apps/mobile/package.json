  },
  "dependencies": {
    "@daengdaeng/tokens": "workspace:*",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-linear-gradient": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eslint": "^9.17.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.7.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "eslint-config-expo"
      ]
    }
