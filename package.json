{
  "name": "daengdaeng-care",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@daengdaeng/web",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@daengdaeng/web",
    "dev:mobile": "pnpm --filter @daengdaeng/mobile start",
    "ios": "pnpm --filter @daengdaeng/mobile ios",
    "android": "pnpm --filter @daengdaeng/mobile android",
    "start": "turbo run start --filter=@daengdaeng/web",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "check": "turbo run type-check lint test build",
    "storybook": "turbo run storybook --filter=@daengdaeng/ui",
    "storybook:build": "turbo run storybook:build --filter=@daengdaeng/ui",
    "chromatic": "turbo run chromatic --filter=@daengdaeng/ui",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "@changesets/cli": "^2.27.10"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
